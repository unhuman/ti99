# Python bytecode. The build scripts delete these every run (a stale .pyc
# is read for a whole second after its source changes -- CLAUDE.md 3A), so a
# tracked one churns on every commit.
__pycache__/
*.pyc

# xas99 bank images. linkticart appends every NAME_b*.bin it finds, so a stale
# one from a previous build inflates the cart; the build scripts delete them.
*_b[0-9].bin
